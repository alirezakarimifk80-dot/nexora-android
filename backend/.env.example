# ============================================================================
# NEXORA FastAPI AI Gateway — Environment Configuration (.env.example)
# Copy this file to .env and populate your server-side credentials.
# NEVER hardcode these keys inside the Android APK.
# ============================================================================

# Active AI Provider: "gemini" | "openai" | "ollama"
AI_PROVIDER="gemini"

# 1. Google Gemini Configuration (Recommended Default)
GEMINI_API_KEY="YOUR_SERVER_SIDE_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.1-flash-lite"

# 2. OpenAI-Compatible Provider Configuration (Optional)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# 3. Ollama Self-Hosted Provider Configuration (Optional)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# 4. Security, Rate Limiting & Payload Guardrails
# Optional Bearer Token: If set, Android requests must include Authorization: Bearer <token>
NEXORA_BACKEND_BEARER_TOKEN=""
RATE_LIMIT_PER_MINUTE="60"
MAX_IMAGE_SIZE_BYTES="4194304"
REQUEST_TIMEOUT_SECONDS="45.0"
ALLOWED_ORIGINS="*"
NEXORA_ENV="production"
NEXORA_DEBUG="false"
