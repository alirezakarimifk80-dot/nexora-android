{
  "name": "nexora-cloudflare-worker",
  "version": "4.0.0",
  "private": true,
  "description": "NEXORA Personal AI Command Center — Serverless Cloudflare Workers + Workers AI + D1 + R2 Backend",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply nexora-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply nexora-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.0"
  }
}
